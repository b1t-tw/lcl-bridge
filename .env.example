GOTRANSLIVE_URL=https://your-lacuna-host.example
SESSION_ID=your-session-id
GOOGLE_DOCUMENT_ID=your-google-document-id
# Optional; defaults to the first tab. Recommended for multi-tab documents.
GOOGLE_TAB_ID=
# Absolute path to a Google Service Account JSON credential (never commit it).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# corrected = corrected source; text = raw recognition; otherwise a translated language key, e.g. en / ja
OUTPUT=corrected
FLUSH_INTERVAL_MS=3000
STATE_PATH=data/bridge.sqlite
